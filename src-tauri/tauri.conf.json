{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XI Zone Editor",
  "version": "1.0.0",
  "identifier": "uk.co.viion.xizoneeditor",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "cd ../ui && npm run dev",
    "beforeBuildCommand": "npm --prefix ui run build || npm --prefix ../ui run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "XI Zone Editor",
        "width": 1500,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
